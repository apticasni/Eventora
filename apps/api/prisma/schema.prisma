generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  CONFIRMED
  EXPIRED
  WITHDRAWN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  role         Role     @default(ATTENDEE)
  avatar       String?
  bio          String?
  interests    String[] @default([])
  googleId     String?  @unique
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings          Booking[]
  organizedEvents   Event[]          @relation("OrganizerEvents")
  reviews           Review[]
  waitlistEntries   WaitlistEntry[]
  proposals         Proposal[]
  certificates      Certificate[]
  passwordResetOTPs PasswordResetOTP[]
  checkInsPerformed CheckIn[]        @relation("CheckInStaff")

  @@index([email])
  @@index([role])
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  icon        String?
  description String?
  color       String?

  events Event[]
}

model Event {
  id               String      @id @default(cuid())
  title            String
  slug             String      @unique
  description      String
  shortDescription String?
  coverImage       String?
  images           String[]    @default([])
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id])
  organizerId      String
  organizer        User        @relation("OrganizerEvents", fields: [organizerId], references: [id])
  status           EventStatus @default(DRAFT)
  format           EventFormat @default(IN_PERSON)

  startDate DateTime
  endDate   DateTime
  timezone  String   @default("Asia/Kolkata")

  venueName    String?
  venueAddress String?
  city         String?
  state        String?
  country      String  @default("India")
  onlineLink   String?

  totalCapacity Int
  bookedSeats   Int     @default(0)
  price         Float   @default(0)
  currency      String  @default("INR")
  isFree        Boolean @default(false)

  instructorName   String?
  instructorBio    String?
  instructorAvatar String?

  tags         String[] @default([])
  schedule     Json?
  requirements String[] @default([])
  whatYouLearn String[] @default([])

  isFeatured Boolean @default(false)
  viewCount  Int     @default(0)

  proposalId String?   @unique
  proposal   Proposal? @relation(fields: [proposalId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings        Booking[]
  reviews         Review[]
  waitlistEntries WaitlistEntry[]
  certificates    Certificate[]
  checkIns        CheckIn[]

  @@index([status])
  @@index([categoryId])
  @@index([organizerId])
  @@index([startDate])
  @@index([isFeatured])
  @@index([city])
  @@index([slug])
}

model Booking {
  id        String        @id @default(cuid())
  reference String        @unique @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id])
  status    BookingStatus @default(PENDING)
  seats     Int           @default(1)
  totalAmount Float
  currency  String        @default("INR")

  payment  Payment?
  tickets  Ticket[]

  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([reference])
}

model Ticket {
  id          String   @id @default(cuid())
  code        String   @unique @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  seatNumber  Int
  qrCode      String?
  isCheckedIn Boolean  @default(false)
  createdAt   DateTime @default(now())

  checkIn CheckIn?

  @@index([bookingId])
  @@index([code])
}

model Payment {
  id                  String        @id @default(cuid())
  bookingId           String        @unique
  booking             Booking       @relation(fields: [bookingId], references: [id])
  razorpayOrderId     String        @unique
  razorpayPaymentId   String?       @unique
  razorpaySignature   String?
  amount              Float
  currency            String        @default("INR")
  status              PaymentStatus @default(PENDING)
  webhookVerified     Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([razorpayOrderId])
  @@index([status])
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  eventId        String
  event          Event          @relation(fields: [eventId], references: [id])
  status         WaitlistStatus @default(WAITING)
  position       Int
  offeredAt      DateTime?
  offerExpiresAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, eventId])
  @@index([eventId, status, position])
}

model Proposal {
  id                String         @id @default(cuid())
  title             String
  description       String
  category          String
  proposedDate      DateTime?
  format            EventFormat    @default(IN_PERSON)
  estimatedCapacity Int?
  price             Float?
  status            ProposalStatus @default(PENDING)
  organizerId       String
  organizer         User           @relation(fields: [organizerId], references: [id])
  adminNotes        String?
  rejectionReason   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  event Event?

  @@index([organizerId])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
  @@index([eventId])
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id])
  code     String   @unique @default(cuid())
  issuedAt DateTime @default(now())

  @@unique([userId, eventId])
}

model CheckIn {
  id          String   @id @default(cuid())
  ticketId    String   @unique
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  staffId     String
  staff       User     @relation("CheckInStaff", fields: [staffId], references: [id])
  checkedInAt DateTime @default(now())
  method      String   @default("QR")

  @@index([eventId])
}

model PasswordResetOTP {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
