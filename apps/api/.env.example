# Use the direct PostgreSQL connection string from your Neon project.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Generate a unique random value of at least 32 characters for production.
JWT_SECRET="<replace-with-a-random-secret-at-least-32-characters>"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Razorpay Test Mode credentials; never use live keys during test setup.
RAZORPAY_KEY_ID="rzp_test_<your-key-id>"
RAZORPAY_KEY_SECRET="<your-razorpay-test-key-secret>"
RAZORPAY_WEBHOOK_SECRET="<your-razorpay-test-webhook-secret>"

# Optional email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Eventora <noreply@example.com>"

# Set these only when intentionally running the demo seed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="<set-a-unique-password>"
ADMIN_NAME="Eventora Admin"
SEED_ORGANIZER_PASSWORD="<set-a-different-unique-password>"
SEED_ATTENDEE_PASSWORD="<set-a-third-unique-password>"

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
